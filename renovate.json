{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>skunklabs-uk/renovate-config"
  ],
  "enabledManagers": [
    "github-actions",
    "custom.regex"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "npm"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchDepTypes": [
        "uses-with"
      ],
      "matchPackageNames": [
        "actions/node-versions"
      ],
      "allowedVersions": "^24.11.0"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchDepTypes": [
        "action"
      ],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Aggiorna il pin di Renovate usato dal workflow di validazione.",
      "managerFilePatterns": [
        "/^\\.github\\/workflows\\/validate-renovate\\.yml$/"
      ],
      "matchStrings": [
        "RENOVATE_VERSION: (?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "renovate",
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    }
  ]
}
